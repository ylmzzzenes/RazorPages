@page "{id}"
@model RazorPages.Pages.Employees.EditModel
@{
	ViewData["Title"] = "Edit";
}

 <form method="post">
		 <input type="hidden" asp-for="Employee.Id">
	 <div class="row mb-3">
		 <label asp-for="Employee.Name" class="col-sm-2 col-from-label"></label>
		 <div class="col-sm-10">
			 <input class="form-control" asp-for="Employee.Name">
		 </div>
	 </div>
	<div class="row mb-3">
		<label asp-for="Employee.Email" class="col-sm-2 col-from-label"></label>
		<div class="col-sm-10">
			<input class="form-control" asp-for="Employee.Email">
		</div>
	</div>
	<div class="row mb-3">
		<label asp-for="Employee.Photo" class="col-sm-2 col-from-label"></label>
		<div class="col-sm-10">
			<input class="form-control" asp-for="Employee.Photo">
		</div>
	</div>
	<div class="row mb-3">
		<label asp-for="Employee.Department" class="col-sm-2 col-from-label"></label>
		<div class="col-sm-10">
			<input class="form-control" asp-for="Employee.Department">
		</div>
	</div>
	<button type="submit" class="btn btn-primary">Update</button>
	<a href="/Employees/Index" class="btn btn-secondary">Cancel</a>
 </form>
