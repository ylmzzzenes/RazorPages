@page 
@using Microsoft.AspNetCore.Mvc.RazorPages
@using RazorPages.Models
@using RazorPages.Repository
@model IndexModel
@{
    ViewData["Title"] = "Employees"; 
}

<h1>Employees</h1>
    <div class="row">
        @foreach(var emp in Model.EmployeeList){
            <div class="col-md-3 mb-2">
                <div class="card">
                    <img src="~/img/@emp.Photo" alt="" class="card-img-top">
                    <div class="card-title">@emp.Name</div>
                    <p class="card-text">@emp.Department</p>
                    <a asp-page="/employees/details" asp-route-id="@emp.Id" class="btn btn-primary">Details</a>
                </div>
            </div>
        }
    </div>


    @functions{
        public class IndexModel : PageModel
        {
            public IEnumerable<Employee> EmployeeList = new List<Employee>();
            private readonly IEmployeeRepository _employeeRepositoy;

			public IndexModel(IEmployeeRepository employeeRepository)
			{
				_employeeRepositoy = employeeRepository;
			}
			public void OnGet()
			{
				EmployeeList = _employeeRepositoy.GetAll();
			}

    }
}